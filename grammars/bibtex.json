{
  "name": "BibTeX",
  "scopeName": "text.bibtex",
  "type": "tree-sitter",
  "parser": "tree-sitter-bibtex",
  "injectionNames": ["bibtex"],
  "fileTypes": ["bib", "bibtex"],
  "comments": {
    "start": "% "
  },
  "treeSitter": {
    // Pin a tag or a full SHA, never a branch. Verify the ref is on the main
    // line before trusting it — `gh api repos/OWNER/REPO/compare/<ref>...HEAD`
    // reporting `diverged` or a nonzero `behind` means it is not.
    "parserSource": "github:latex-lsp/tree-sitter-bibtex#8d04ed27b3bc7929f14b7df9236797dab9f3fa66",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "bibtex.wasm",
    "highlightsQuery": "bibtex-highlights.scm",
    "injectionsQuery": "bibtex-injections.scm",
    "foldsQuery": "bibtex-folds.scm",
    "indentsQuery": "bibtex-indents.scm",
    "tagsQuery": "bibtex-tags.scm"
  }
}
